generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  TENANT_ADMIN
  ADMIN
}

enum JobApplicationStatus {
  APPLIED
  OA
  INTERVIEW
  OFFER
  REJECTED
}

enum AssessmentDifficulty {
  EASY
  MEDIUM
  HARD
}

enum AssessmentLanguage {
  JAVASCRIPT
  PYTHON
  CPP
}

enum SubmissionStatus {
  QUEUED
  RUNNING
  ACCEPTED
  WRONG_ANSWER
  RUNTIME_ERROR
  TIME_LIMIT_EXCEEDED
  COMPILE_ERROR
}

enum TestCaseResultStatus {
  PASS
  FAIL
  ERROR
}

enum ComparisonMode {
  EXACT
  UNORDERED
  FLOAT_TOLERANT
}

enum ForumPostStatus {
  PUBLISHED
  FLAGGED
  REMOVED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum BadgeCriteriaType {
  PROBLEMS_SOLVED
  STREAK_DAYS
  ASSESSMENTS_COMPLETED
  FORUM_POSTS
  POINTS
}

enum NotificationType {
  BADGE_AWARDED
  STREAK_MILESTONE
  FORUM_REPLY
  FORUM_UPVOTE
  SUBMISSION_ACCEPTED
  PREPARATION_REMINDER
  PEER_INVITATION
  PEER_SESSION_CHANGED
  SCORECARD_REQUEST
  SYSTEM
}

enum ContestStatus {
  DRAFT
  SCHEDULED
  LIVE
  ENDED
}

enum PathLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum ResumeStatus {
  PROCESSING
  COMPLETED
  FAILED
}

enum InterviewPreparationArchetype {
  GENERAL
  FAANG
  STARTUP
  ENTERPRISE
}

enum InterviewRoundType {
  CODING
  SYSTEM_DESIGN
  BEHAVIORAL
  RESUME_ROLE_FIT
  CUSTOM
}

enum InterviewPreparationPlanStatus {
  ACTIVE
  ARCHIVED
  COMPLETED
}

enum PreparationTaskStatus {
  PENDING
  COMPLETED
}

enum PreparationTaskType {
  SOLVE_PROBLEM
  REVIEW_PROBLEM
  COMPLETE_PATH
  ANALYZE_RESUME
  RUN_MOCK_INTERVIEW
  SCHEDULE_PEER_PRACTICE
  CUSTOM
}

enum PreparationResourceType {
  PROBLEM
  PROBLEM_COLLECTION
  LEARNING_PATH
  REVIEW_QUEUE
  RESUME_ANALYSIS
  MOCK_INTERVIEW
  PEER_SESSION
}

enum InterviewReadinessStatus {
  INSUFFICIENT_EVIDENCE
  NEEDS_WORK
  PROGRESSING
  READY
}

enum PeerPracticeStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
  COMPLETED
  NO_SHOW
}

model Tenant {
  id               String       @id @default(uuid())
  name             String
  stripeCustomerId String?
  subscriptionPlan String       @default("FREE")
  seatLimit        Int          @default(5)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  users            User[]
  invitations      Invitation[]
}

model User {
  id                            String                         @id @default(uuid())
  tenantId                      String?
  email                         String                         @unique
  passwordHash                  String?
  googleId                      String?                        @unique
  firstName                     String?
  lastName                      String?
  headline                      String?
  role                          UserRole                       @default(USER)
  createdAt                     DateTime                       @default(now())
  updatedAt                     DateTime                       @updatedAt
  tenant                        Tenant?                        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  refreshTokens                 RefreshToken[]
  auditLogs                     AuditLog[]
  jobApplications               JobApplication[]
  submissions                   Submission[]
  forumPosts                    ForumPost[]
  forumComments                 ForumComment[]
  forumPostVotes                ForumPostVote[]
  forumCommentVotes             ForumCommentVote[]
  forumReports                  ForumReport[]
  stats                         UserStats?
  sentInvitations               Invitation[]
  dailyChallengeCompletions     DailyChallengeCompletion[]
  userBadges                    UserBadge[]
  notifications                 Notification[]
  notificationPreferences       NotificationPreference[]
  problemDiscussions            ProblemDiscussion[]
  problemDiscussionComments     ProblemDiscussionComment[]
  problemDiscussionVotes        ProblemDiscussionVote[]
  problemDiscussionCommentVotes ProblemDiscussionCommentVote[]
  bookmarks                     Bookmark[]
  problemNotes                  ProblemNote[]
  problemLists                  ProblemList[]
  reviewItems                   ReviewItem[]
  pathEnrollments               PathEnrollment[]
  contestParticipations         ContestParticipant[]
  resumes                       Resume[]
  interviewPreparationPlans    InterviewPreparationPlan[]
  organizedPeerSessions        PeerPracticeSession[]          @relation("PeerPracticeOrganizer")
  invitedPeerSessions          PeerPracticeSession[]          @relation("PeerPracticeInvitee")
  peerScorecards               PeerScorecard[]                 @relation("PeerScorecardEvaluator")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  metadata  Json?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model FeatureFlag {
  id                String   @id @default(uuid())
  flagKey           String   @unique
  isEnabled         Boolean  @default(false)
  percentageRollout Int      @default(100)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model JobApplication {
  id                String               @id @default(uuid())
  userId            String
  company           String
  role              String
  status            JobApplicationStatus @default(APPLIED)
  salaryRange       String?
  jobDescriptionUrl String?
  interviewDate     DateTime?
  boardPosition     Int                  @default(0)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  user              User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  preparationPlan   InterviewPreparationPlan?

  @@index([userId, status])
}

model Problem {
  id                String               @id @default(uuid())
  tenantId          String?
  slug              String               @unique
  title             String
  difficulty        AssessmentDifficulty
  description       String
  constraints       String[]
  tags              String[]
  starterCode       Json
  examples          Json
  functionName      String
  harness           Json
  referenceSolution Json
  comparisonMode    ComparisonMode       @default(EXACT)
  timeLimitMinutes  Int                  @default(30)
  isPublished       Boolean              @default(false)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  testCases         ProblemTestCase[]
  submissions       Submission[]
  dailyChallenges   DailyChallenge[]
  discussions       ProblemDiscussion[]
  bookmarks         Bookmark[]
  notes             ProblemNote[]
  listItems         ProblemListItem[]
  reviewItems       ReviewItem[]
  contestProblems   ContestProblem[]
  learningPathItems LearningPathItem[]

  @@index([difficulty, isPublished])
}

model ProblemTestCase {
  id             String  @id @default(uuid())
  problemId      String
  ordinal        Int
  input          String
  expectedOutput String
  isHidden       Boolean @default(false)
  problem        Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@unique([problemId, ordinal])
  @@index([problemId, isHidden])
}

model Submission {
  id             String             @id @default(uuid())
  userId         String
  problemId      String
  language       AssessmentLanguage
  sourceCode     String
  status         SubmissionStatus
  passedCount    Int                @default(0)
  totalCount     Int                @default(0)
  totalRuntimeMs Float              @default(0)
  peakMemoryKb   Int                @default(0)
  stdout         String             @default("")
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem        Problem            @relation(fields: [problemId], references: [id], onDelete: Cascade)
  results        SubmissionResult[]

  @@index([userId, problemId])
  @@index([problemId, status])
}

model SubmissionResult {
  id           String               @id @default(uuid())
  submissionId String
  testCaseId   String
  label        String
  status       TestCaseResultStatus
  actualOutput String               @default("")
  runtimeMs    Float                @default(0)
  memoryKb     Int                  @default(0)
  isHidden     Boolean              @default(false)
  submission   Submission           @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId])
}

model ForumPost {
  id        String          @id @default(uuid())
  userId    String
  title     String
  body      String
  tags      String[]
  status    ForumPostStatus @default(PUBLISHED)
  viewCount Int             @default(0)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  comments  ForumComment[]
  votes     ForumPostVote[]
  reports   ForumReport[]

  @@index([status, createdAt])
  @@index([userId])
}

model ForumComment {
  id        String             @id @default(uuid())
  postId    String
  userId    String
  body      String
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  post      ForumPost          @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  votes     ForumCommentVote[]

  @@index([postId])
}

model ForumPostVote {
  postId    String
  userId    String
  createdAt DateTime  @default(now())
  post      ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId])
}

model ForumCommentVote {
  commentId String
  userId    String
  createdAt DateTime     @default(now())
  comment   ForumComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([commentId, userId])
}

model ForumReport {
  id         String    @id @default(uuid())
  postId     String
  reporterId String
  reason     String
  createdAt  DateTime  @default(now())
  post       ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  reporter   User      @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([postId])
}

model UserStats {
  userId               String    @id
  points               Int       @default(0)
  monthlyPoints        Int       @default(0)
  weeklyPoints         Int       @default(0)
  assessmentsCompleted Int       @default(0)
  badges               String[]
  streakDays           Int       @default(0)
  longestStreak        Int       @default(0)
  lastActiveDate       DateTime? @db.Date
  updatedAt            DateTime  @updatedAt
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Invitation {
  id          String           @id @default(uuid())
  tenantId    String
  email       String
  token       String           @unique
  status      InvitationStatus @default(PENDING)
  invitedById String
  createdAt   DateTime         @default(now())
  expiresAt   DateTime
  acceptedAt  DateTime?
  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invitedBy   User             @relation(fields: [invitedById], references: [id])

  @@index([tenantId])
  @@index([token])
}

model DailyChallenge {
  id            String                     @id @default(uuid())
  challengeDate DateTime                   @db.Date
  problemId     String
  tenantId      String?
  createdAt     DateTime                   @default(now())
  problem       Problem                    @relation(fields: [problemId], references: [id], onDelete: Cascade)
  completions   DailyChallengeCompletion[]

  @@unique([challengeDate, tenantId])
  @@index([challengeDate])
}

model DailyChallengeCompletion {
  id               String         @id @default(uuid())
  userId           String
  dailyChallengeId String
  submissionId     String
  completedAt      DateTime       @default(now())
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  dailyChallenge   DailyChallenge @relation(fields: [dailyChallengeId], references: [id], onDelete: Cascade)

  @@unique([userId, dailyChallengeId])
  @@index([dailyChallengeId])
}

model Contest {
  id           String               @id @default(uuid())
  slug         String               @unique
  title        String
  description  String
  startsAt     DateTime
  endsAt       DateTime
  status       ContestStatus        @default(DRAFT)
  tenantId     String?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  problems     ContestProblem[]
  participants ContestParticipant[]

  @@index([status, startsAt])
}

model ContestProblem {
  id        String  @id @default(uuid())
  contestId String
  problemId String
  ordinal   Int
  points    Int     @default(100)
  contest   Contest @relation(fields: [contestId], references: [id], onDelete: Cascade)
  problem   Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@unique([contestId, problemId])
  @@index([contestId])
}

model ContestParticipant {
  id           String   @id @default(uuid())
  contestId    String
  userId       String
  registeredAt DateTime @default(now())
  contest      Contest  @relation(fields: [contestId], references: [id], onDelete: Cascade)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([contestId, userId])
  @@index([contestId])
}

model Badge {
  id           String            @id @default(uuid())
  key          String            @unique
  name         String
  description  String
  icon         String
  criteriaType BadgeCriteriaType
  threshold    Int
  tenantId     String?
  isActive     Boolean           @default(true)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  userBadges   UserBadge[]

  @@index([isActive])
}

model UserBadge {
  id        String   @id @default(uuid())
  userId    String
  badgeId   String
  awardedAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge     Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
  @@index([userId])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  tenantId  String?
  type      NotificationType
  title     String
  body      String
  linkUrl   String?
  metadata  Json?
  dedupeKey String?          @unique
  readAt    DateTime?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

model NotificationPreference {
  id           String           @id @default(uuid())
  userId       String
  type         NotificationType
  inAppEnabled Boolean          @default(true)
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
}

model ProblemDiscussion {
  id        String                     @id @default(uuid())
  problemId String
  userId    String
  title     String
  body      String
  createdAt DateTime                   @default(now())
  updatedAt DateTime                   @updatedAt
  problem   Problem                    @relation(fields: [problemId], references: [id], onDelete: Cascade)
  user      User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  comments  ProblemDiscussionComment[]
  votes     ProblemDiscussionVote[]

  @@index([problemId, createdAt])
  @@index([userId])
}

model ProblemDiscussionComment {
  id           String                         @id @default(uuid())
  discussionId String
  userId       String
  body         String
  createdAt    DateTime                       @default(now())
  updatedAt    DateTime                       @updatedAt
  discussion   ProblemDiscussion              @relation(fields: [discussionId], references: [id], onDelete: Cascade)
  user         User                           @relation(fields: [userId], references: [id], onDelete: Cascade)
  votes        ProblemDiscussionCommentVote[]

  @@index([discussionId])
}

model ProblemDiscussionVote {
  discussionId String
  userId       String
  createdAt    DateTime          @default(now())
  discussion   ProblemDiscussion @relation(fields: [discussionId], references: [id], onDelete: Cascade)
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([discussionId, userId])
}

model ProblemDiscussionCommentVote {
  commentId String
  userId    String
  createdAt DateTime                 @default(now())
  comment   ProblemDiscussionComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      User                     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([commentId, userId])
}

model Bookmark {
  id        String   @id @default(uuid())
  userId    String
  problemId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem   Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@unique([userId, problemId])
  @@index([userId, createdAt])
}

model ProblemNote {
  id        String   @id @default(uuid())
  userId    String
  problemId String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem   Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@unique([userId, problemId])
}

model ProblemList {
  id        String            @id @default(uuid())
  userId    String
  name      String
  isPublic  Boolean           @default(false)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     ProblemListItem[]

  @@index([userId])
}

model ProblemListItem {
  id        String      @id @default(uuid())
  listId    String
  problemId String
  ordinal   Int
  list      ProblemList @relation(fields: [listId], references: [id], onDelete: Cascade)
  problem   Problem     @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@unique([listId, problemId])
  @@index([listId, ordinal])
}

model ReviewItem {
  id             String    @id @default(uuid())
  userId         String
  problemId      String
  ease           Float     @default(2.5)
  intervalDays   Int       @default(0)
  repetitions    Int       @default(0)
  dueAt          DateTime
  lastReviewedAt DateTime?
  createdAt      DateTime  @default(now())
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem        Problem   @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@unique([userId, problemId])
  @@index([userId, dueAt])
}

model LearningPath {
  id          String               @id @default(uuid())
  slug        String               @unique
  title       String
  description String
  level       PathLevel            @default(BEGINNER)
  tags        String[]
  coverImage  String?
  isPublished Boolean              @default(false)
  tenantId    String?
  order       Int                  @default(0)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  modules     LearningPathModule[]
  enrollments PathEnrollment[]

  @@index([isPublished, order])
  @@index([tenantId])
}

model LearningPathModule {
  id     String             @id @default(uuid())
  pathId String
  title  String
  order  Int
  path   LearningPath       @relation(fields: [pathId], references: [id], onDelete: Cascade)
  items  LearningPathItem[]

  @@index([pathId, order])
}

model LearningPathItem {
  id        String             @id @default(uuid())
  moduleId  String
  problemId String
  order     Int
  module    LearningPathModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  problem   Problem            @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@unique([moduleId, problemId])
  @@index([moduleId, order])
}

model PathEnrollment {
  id         String       @id @default(uuid())
  userId     String
  pathId     String
  enrolledAt DateTime     @default(now())
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  path       LearningPath @relation(fields: [pathId], references: [id], onDelete: Cascade)

  @@unique([userId, pathId])
  @@index([userId])
}

model Resume {
  id                String       @id @default(uuid())
  userId            String
  tenantId          String?
  fileName          String
  status            ResumeStatus @default(PROCESSING)
  atsScore          Int?
  parsedSkills      String[]
  missingSkills     String[]
  structureFeedback Json?
  actionableTips    String[]
  summary           String?
  failureReason     String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model InterviewPreparationPlan {
  id               String                           @id @default(uuid())
  userId           String
  jobApplicationId String                           @unique
  targetAt         DateTime
  timeZone         String
  archetype        InterviewPreparationArchetype
  status           InterviewPreparationPlanStatus  @default(ACTIVE)
  version          Int                              @default(0)
  readinessRevision Int                              @default(0)
  readinessInvalidatedAt DateTime?
  createdAt        DateTime                         @default(now())
  updatedAt        DateTime                         @updatedAt
  user             User                             @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobApplication   JobApplication                   @relation(fields: [jobApplicationId], references: [id], onDelete: Cascade)
  rounds           InterviewPreparationRound[]
  tasks            PreparationTask[]
  snapshots        ReadinessSnapshot[]
  peerSessions     PeerPracticeSession[]

  @@index([userId, status, targetAt])
}

model InterviewPreparationRound {
  id           String                     @id @default(uuid())
  planId       String
  type         InterviewRoundType
  title        String
  weight       Float
  ordinal      Int
  version      Int                        @default(0)
  createdAt    DateTime                   @default(now())
  updatedAt    DateTime                   @updatedAt
  plan         InterviewPreparationPlan   @relation(fields: [planId], references: [id], onDelete: Cascade)
  tasks        PreparationTask[]
  peerSessions PeerPracticeSession[]

  @@unique([planId, ordinal])
  @@index([planId, type])
}

model PreparationTask {
  id           String                    @id @default(uuid())
  planId       String
  roundId      String
  type         PreparationTaskType
  title        String
  description  String?
  status       PreparationTaskStatus     @default(PENDING)
  dueAt        DateTime?
  completedAt  DateTime?
  resourceType PreparationResourceType?
  resourceId   String?
  deepLink     String?
  ordinal      Int
  version      Int                       @default(0)
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt
  plan         InterviewPreparationPlan  @relation(fields: [planId], references: [id], onDelete: Cascade)
  round        InterviewPreparationRound @relation(fields: [roundId], references: [id], onDelete: Cascade)

  @@unique([planId, ordinal])
  @@index([planId, status, dueAt])
  @@index([roundId, ordinal])
}

model ReadinessSnapshot {
  id                           String                     @id @default(uuid())
  planId                       String
  formulaVersion               String
  sourceRevision               Int
  score                        Float?
  status                       InterviewReadinessStatus
  confidence                   Float
  coverage                     Float
  rounds                       Json
  deterministicRecommendations String[]
  aiExplanation                String?
  aiSnapshotId                 String?
  calculatedAt                 DateTime                   @default(now())
  plan                         InterviewPreparationPlan   @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId, calculatedAt(sort: Desc)])
}

model PeerPracticeSession {
  id              String                    @id @default(uuid())
  planId          String
  roundId         String
  organizerId     String
  inviteeId       String
  status          PeerPracticeStatus        @default(PENDING)
  startsAt        DateTime
  timeZone        String
  durationMinutes Int
  meetingUrl      String
  version         Int                       @default(0)
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt
  plan            InterviewPreparationPlan  @relation(fields: [planId], references: [id], onDelete: Cascade)
  round           InterviewPreparationRound @relation(fields: [roundId], references: [id], onDelete: Cascade)
  organizer       User                      @relation("PeerPracticeOrganizer", fields: [organizerId], references: [id], onDelete: Cascade)
  invitee         User                      @relation("PeerPracticeInvitee", fields: [inviteeId], references: [id], onDelete: Cascade)
  scorecards      PeerScorecard[]

  @@index([organizerId, startsAt])
  @@index([inviteeId, startsAt])
  @@index([planId, status])
  @@unique([roundId, organizerId, inviteeId, startsAt])
}

model PeerScorecard {
  id             String              @id @default(uuid())
  sessionId      String
  evaluatorId    String
  communication  Int
  problemSolving Int
  technicalDepth Int
  structure      Int
  strengths      String[]
  improvements   String[]
  submittedAt    DateTime            @default(now())
  session        PeerPracticeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  evaluator      User                @relation("PeerScorecardEvaluator", fields: [evaluatorId], references: [id], onDelete: Cascade)

  @@unique([sessionId, evaluatorId])
  @@index([evaluatorId, submittedAt])
}
