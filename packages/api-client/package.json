{
  "name": "@elevatesde/api-client",
  "version": "0.0.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "lint": "eslint \"src/**/*.ts\"",
    "type-check": "tsc --noEmit && tsc --noEmit -p tsconfig.spec.json",
    "test": "jest"
  },
  "dependencies": {
    "@elevatesde/shared-types": "workspace:*",
    "axios": "^1.18.0",
    "js-cookie": "^3.0.8",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@elevatesde/eslint-config": "workspace:*",
    "@elevatesde/ts-config": "workspace:*",
    "@types/jest": "^30.0.0",
    "@types/js-cookie": "^3.0.6",
    "eslint": "^9.0.0",
    "jest": "^30.0.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5"
  },
  "jest": {
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "testEnvironment": "node",
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "tsconfig": "<rootDir>/../tsconfig.spec.json"
        }
      ]
    }
  }
}
